{
  "name": "mnp-media-downloader",
  "version": "1.0.0",
  "description": "Download videos and audio from social media",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "bash scripts/fetch-binaries.sh && electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "bash scripts/fetch-binaries.sh && electron-vite build && electron-builder --mac --arm64",
    "fetch-binaries": "bash scripts/fetch-binaries.sh"
  },
  "keywords": [],
  "author": "MNP",
  "license": "ISC",
  "dependencies": {
    "electron-store": "^11.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "productName": "MNP Media Downloader",
  "build": {
    "appId": "com.mnp.mediadownloader",
    "productName": "MNP Media Downloader",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "dir"
      ],
      "identity": null
    },
    "dmg": {
      "title": "MNP Media Downloader"
    },
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/tray",
        "to": "tray"
      }
    ]
  }
}
